{
  "info": {
    "name": "DeliveryFlow — практика №6",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://delivery-api-gusanova.msk1.amvera.tech"
    }
  ],
  "item": [
    {
      "name": "Расчёт RUB — успешный",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/integration/quote",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "integration",
            "quote"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fromCity\": \"Москва\",\n  \"toCity\": \"Нижний Новгород\",\n  \"weight\": 10,\n  \"type\": \"express\",\n  \"currency\": \"RUB\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(pm.response.json().delivery.cost).to.eql(737);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
